{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Run analysis script (terminal output)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_analysis.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
